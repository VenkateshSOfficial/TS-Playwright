{
    "name": "typescript-playwright-framework",
    "version": "1.0.0",
    "description": "End-to-end UI and API test automation framework using Playwright and TypeScript",
    "private": true,
    "license": "MIT",
    "author": "QA Automation Team",
    "type": "commonjs",
    "engines": {
        "node": ">=20 <23",
        "npm": ">=10"
    },
    "packageManager": "npm@10.9.0",
    "scripts": {
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "test:smoke": "playwright test --grep @smoke",
        "test:regression": "playwright test --grep @regression",
        "report": "playwright show-report",
        "clean:results": "node -e \"const fs=require('fs');['playwright-report','test-results'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}));\""
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@types/node": "^25.6.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "csv-parse": "^6.2.1"
    }
}